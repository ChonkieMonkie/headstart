{
  "name": "@headstart/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Headstart desktop app for Windows, macOS and Linux (Tauri 2 + SvelteKit).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
