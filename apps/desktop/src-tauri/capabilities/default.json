{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window. Keep this list as small as possible.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "updater:default",
    "process:allow-restart",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute"
  ]
}
