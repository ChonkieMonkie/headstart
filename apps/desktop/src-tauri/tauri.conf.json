{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Headstart",
  "version": "../package.json",
  "identifier": "app.headstart.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Headstart",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Education",
    "shortDescription": "A study companion that helps you get started",
    "longDescription": "Headstart helps you get started, stay focused and keep going, with a mascot that rewards real studying.",
    "copyright": "Copyright © 2026 Headstart contributors. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFERUZGQkVGQjM5MTJDQTMKUldTakxKR3o3L3Z2clNRR0YrbXBqNW5Xc0srTTNHeDJZbHMySVFCL2c1WjBONDhSeldpWTA0NmcK",
      "endpoints": [
        "https://github.com/ChonkieMonkie/headstart/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
